# Home/LAN mode automatically uses Expo's current private host on port 8000.
# For Expo --tunnel mode, expose Laravel separately and set its HTTPS URL here.
# EXPO_PUBLIC_BACKEND_TUNNEL_API=https://your-backend-tunnel.example.com/api
#
# Optional primary override for a hosted API or a backend on another machine.
# EXPO_PUBLIC_BACKEND_API=https://api.example.com/api
# Standalone APKs have no Expo LAN host. Set EXPO_PUBLIC_BACKEND_API and the
# Maps SDK keys in the EAS preview environment before a cloud preview build.
# Use the reachable HTTPS Laravel tunnel URL for local demonstrations.
# EXPO_PUBLIC_BACKEND_FALLBACK_TIMEOUT_MS=4000
# Restrict these SDK keys to the Android package + signing SHA-1 and iOS bundle ID.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
