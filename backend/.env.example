APP_NAME="Jamjade Car Rental"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=backend
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_EXPIRATION=43200
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

RESEND_API_KEY=your_resend_api_key_here
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD="${RESEND_API_KEY}"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="booking@yourdomain.com"
MAIL_FROM_NAME="Jamjade Car Rental"
MAIL_BOOKING_CONFIRMATIONS_QUEUE=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=PHP
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=
# Comma-separated trusted web origins for Expo web PayPal callbacks.
PAYPAL_APP_CALLBACK_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

VITE_APP_NAME="${APP_NAME}"

# Local handover flow testing only; ignored outside local/testing.
TELEMATICS_HANDOVER_TEST_MODE=false

# Server-only key: enable Places API (New) and Routes API; restrict to backend IPs.
GOOGLE_MAPS_SERVER_KEY=
